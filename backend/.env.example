# Замените значения на данные вашей локальной PostgreSQL.
TRIP_APP_NAME="Конструктор путешествий"
TRIP_APP_ENV=development
TRIP_DEBUG=true
TRIP_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/trip_constructor
TRIP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRIP_JWT_SECRET_KEY=replace-with-a-long-random-secret
TRIP_JWT_ALGORITHM=HS256
TRIP_ACCESS_TOKEN_EXPIRE_MINUTES=60
